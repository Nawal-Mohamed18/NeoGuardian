# NeoGuardian local / deploy environment
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production-use-at-least-32-chars

# PostgreSQL (required) — paste ONE of:
# A) Shared Neon URL from your team lead (same live demo DB for everyone):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# B) Local Postgres / Docker Compose default:
DATABASE_URL=postgresql://neoguardian:neoguardian@127.0.0.1:5432/neoguardian
POSTGRES_DB=neoguardian
POSTGRES_USER=neoguardian
POSTGRES_PASSWORD=neoguardian
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Hosted (Railway): set DEBUG=false, ALLOWED_HOSTS=*, and paste Neon DATABASE_URL
# ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app

# Optional AI
OPENAI_API_KEY=
ASSESSMENT_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true
