# NeoGuardian local / deploy environment
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production

# PostgreSQL (required)
# Local Docker default:
DATABASE_URL=postgresql://neoguardian:neoguardian@127.0.0.1:5432/neoguardian
POSTGRES_DB=neoguardian
POSTGRES_USER=neoguardian
POSTGRES_PASSWORD=neoguardian
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional AI
OPENAI_API_KEY=
ASSESSMENT_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true
